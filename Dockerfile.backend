FROM debian:stable
LABEL org.opencontainers.image.title="Cafefe backend PPI115"
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-21-jre-headless ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/* \
    && ln -s "$(dirname "$(dirname "$(readlink -f /usr/bin/java)")")" /opt/java
COPY docker/backend/descargar.sh /tmp/descargar.sh
RUN sh /tmp/descargar.sh && rm /tmp/descargar.sh \
    && chmod -R a+rX /opt/liberty /opt/libraries \
    && useradd --uid 10001 --create-home --home-dir /home/cafefe cafefe \
    && mkdir -p /opt/war /opt/liberty/wlp/usr/servers/cafefe \
    && chown -R cafefe:cafefe /opt/liberty/wlp/usr /opt/war
COPY --chown=cafefe:cafefe docker/backend/server.xml /opt/liberty/wlp/usr/servers/cafefe/server.xml
COPY --chmod=755 docker/backend/iniciar.sh /usr/local/bin/iniciar-cafefe
ENV JAVA_HOME=/opt/java
USER 10001:10001
EXPOSE 9080
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s CMD curl -fsS http://127.0.0.1:9080/cafefe/api/tipos-producto > /dev/null || exit 1
ENTRYPOINT ["/usr/local/bin/iniciar-cafefe"]
