<server description="Open Liberty Server">

    <featureManager>
        <feature>webProfile-10.0</feature>
        <feature>faces-4.0</feature>
        <feature>jdbc-4.2</feature>
    </featureManager>

    <!-- Endpoint local explícito, también al iniciar fuera de liberty:dev. -->
    <httpEndpoint id="defaultHttpEndpoint" host="localhost" httpPort="9080"/>

    <httpSession cookieHttpOnly="true" cookieSameSite="Lax"
                 useContextRootAsCookiePath="true" invalidationTimeout="30m"
                 urlRewritingEnabled="false"/>

    <!-- Solo el frontend de desarrollo aprobado; limitado al contexto REST. -->
    <cors id="cafefeFrontendDesarrollo"
          domain="/Cafefe_PPI_2026-1.0-SNAPSHOT/api/"
          allowedOrigins="http://127.0.0.1:5501"
          allowedMethods="GET,POST,PUT,DELETE,OPTIONS"
          allowedHeaders="Content-Type,Accept"
          allowCredentials="true"
          maxAge="0"/>

    <!-- Definición de la librería del driver -->
    <library id="PostgreSQLLib">
        <fileset dir="${server.config.dir}/lib/postgres" includes="postgresql-42.7.3.jar"/>
    </library>

    <!-- PrimeFaces es provided: también debe estar disponible fuera de Docker. -->
    <library id="global">
        <fileset dir="${server.config.dir}/lib/primefaces" includes="primefaces-13.0.0-jakarta.jar"/>
    </library>

    <!-- Conector JDBC -->
    <jdbcDriver id="PostgreSQLDriver" libraryRef="PostgreSQLLib"/>

    <!-- DataSource apuntando a tu PostgreSQL local en Docker -->
    <dataSource id="PostgreSQLDS" jndiName="jdbc/CafefeDS">
        <jdbcDriver ref="PostgreSQLDriver"/>
        <properties.postgresql
            serverName="${env.PG_HOST}"
            portNumber="${env.PG_PORT}"
            databaseName="${env.PG_DB}"
            user="${env.PG_USER}"
            password="${env.PG_PASS}"/>
    </dataSource>

</server>
